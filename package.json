{
  "name": "mazacofo",
  "version": "2.0.0",
  "description": "Codeforces rating badge generator",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev --var MAZA_ENV:development",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vitest run"
  },
  "dependencies": {
    "@sentry/cloudflare": "^11.11.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
